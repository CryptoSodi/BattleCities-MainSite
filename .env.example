# Solana testnet only. Never place a wallet secret key in this project.
PRESALE_NETWORK=testnet
SOLANA_RPC_URL=https://api.testnet.solana.com
PRESALE_TREASURY_ADDRESS=

# Generate a random value of at least 32 characters and keep it server-side.
PRESALE_QUOTE_SECRET=

# September 13, 2026 at 00:00 UTC.
PRESALE_END_AT=2026-09-13T00:00:00.000Z

# Use either a live Pyth feed or a fixed test-only fallback.
PYTH_SOL_USD_FEED_ID=
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
SOL_USD_PRICE=150

# Optional test-USDC support. Leave blank to disable the USDC payment tab.
PRESALE_USDC_MINT=

# Comma-separated origins allowed to call the API when frontend/backend differ.
PRESALE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=3000
